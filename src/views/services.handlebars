<section class="page-section">
    <h2>Nuestros servicios</h2>
    <p class="page-description">
        Consultá los servicios disponibles, sus precios y duración.
        Podés crear, editar o eliminar servicios desde esta página.
    </p>

    <form id="create-service-form" class="management-form">
        <h3>Agregar un servicio</h3>

        <div class="form-grid">
            <label>
                Nombre
                <input
                    type="text"
                    name="name"
                    required
                    maxlength="100"
                    autocomplete="off"
                >
            </label>

            <label>
                Categoría
                <input
                    type="text"
                    name="category"
                    required
                    maxlength="100"
                >
            </label>

            <label>
                Descripción
                <textarea
                    name="description"
                    rows="3"
                    required
                    maxlength="500"
                ></textarea>
            </label>

            <label>
                Duración (minutos)
                <input
                    type="number"
                    name="duration"
                    min="5"
                    max="240"
                    step="1"
                    required
                >
            </label>

            <label>
                Precio
                <input
                    type="number"
                    name="price"
                    min="0"
                    max="1000000"
                    step="0.01"
                    required
                >
            </label>

            <label class="checkbox-label">
                <input
                    type="checkbox"
                    name="available"
                    checked
                >
                Disponible para reservas
            </label>
        </div>

        <button class="button button-primary" type="submit">
            Crear servicio
        </button>

        <p
            id="service-feedback"
            class="form-feedback"
            aria-live="polite"
        ></p>
    </form>

    <h3 class="section-subtitle">Servicios registrados</h3>

    <!-- Socket.IO actualiza estas tarjetas sin recargar la página. -->
    <div id="services-list" class="services-grid">
        {{#each services}}
            <article
                class="service-card"
                data-service-id="{{this._id}}"
                data-name="{{this.name}}"
                data-description="{{this.description}}"
                data-duration="{{this.duration}}"
                data-price="{{this.price}}"
                data-category="{{this.category}}"
                data-available="{{this.available}}"
            >
                <h3>{{this.name}}</h3>
                <p>{{this.description}}</p>

                <dl class="service-details">
                    <div>
                        <dt>Duración</dt>
                        <dd>{{this.duration}} minutos</dd>
                    </div>

                    <div>
                        <dt>Precio</dt>
                        <dd>${{this.price}}</dd>
                    </div>

                    <div>
                        <dt>Categoría</dt>
                        <dd>{{this.category}}</dd>
                    </div>

                    <div>
                        <dt>Disponibilidad</dt>
                        <dd>
                            {{#if this.available}}
                                Disponible
                            {{else}}
                                No disponible
                            {{/if}}
                        </dd>
                    </div>
                </dl>

                <div class="card-actions">
                    <button
                        type="button"
                        class="button button-secondary"
                        data-action="edit-service"
                    >
                        Editar
                    </button>

                    <button
                        type="button"
                        class="button button-danger"
                        data-action="delete-service"
                    >
                        Eliminar
                    </button>
                </div>
            </article>
        {{else}}
            <p class="empty-message">
                No hay servicios registrados.
            </p>
        {{/each}}
    </div>
</section>

<!-- Formulario de edición reutilizable. -->
<dialog id="edit-service-dialog" class="modal-dialog">
    <form id="edit-service-form" class="dialog-content">
        <div class="dialog-header">
            <h2>Editar servicio</h2>

            <button
                type="button"
                id="cancel-service-edit"
                class="button button-secondary"
            >
                Cerrar
            </button>
        </div>

        <input type="hidden" name="serviceId">

        <div class="form-grid">
            <label>
                Nombre
                <input type="text" name="name" required maxlength="100">
            </label>

            <label>
                Categoría
                <input type="text" name="category" required maxlength="100">
            </label>

            <label>
                Descripción
                <textarea
                    name="description"
                    rows="3"
                    required
                    maxlength="500"
                ></textarea>
            </label>

            <label>
                Duración (minutos)
                <input
                    type="number"
                    name="duration"
                    min="5"
                    max="240"
                    step="1"
                    required
                >
            </label>

            <label>
                Precio
                <input
                    type="number"
                    name="price"
                    min="0"
                    max="1000000"
                    step="0.01"
                    required
                >
            </label>

            <label class="checkbox-label">
                <input type="checkbox" name="available">
                Disponible para reservas
            </label>
        </div>

        <button class="button button-primary" type="submit">
            Guardar cambios
        </button>

        <p
            id="edit-service-feedback"
            class="form-feedback"
            aria-live="polite"
        ></p>
    </form>
</dialog>

<script src="/js/services.js"></script>